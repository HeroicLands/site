{
    "name": "heroiclands-site",
    "private": true,
    "version": "0.0.0",
    "description": "heroiclands.org — the project's front door, built with package-build.",
    "homepage": "https://www.heroiclands.org/",
    "type": "module",
    "license": "GPL-3.0-or-later",
    "author": {
        "name": "Tom Rodriguez",
        "email": "toasty@heroiclands.org"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HeroicLands/site.git"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "prepare": "git config core.hooksPath .githooks || true",
        "build": "package-build site build",
        "serve": "package-build site serve",
        "check:assets": "node utils/check-assets.mjs",
        "roster": "node utils/build-roster.mjs",
        "check:roster": "node utils/build-roster.mjs --check",
        "format": "package-build format --write",
        "format:check": "package-build format",
        "lint:markdown": "package-build markdown",
        "lint:markdown:fix": "package-build markdown --fix"
    },
    "devDependencies": {
        "@heroiclands/package-build": "^25.8.0"
    },
    "overrides": {
        "@heroiclands/package-build": {
            "minimatch": "^11.0.3"
        }
    }
}
